GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=openai/gpt-oss-20b

# Orígenes que pueden llamar a la API (lista JSON). En producción: la URL de Vercel.
# CORS_ORIGINS=["https://tu-proyecto.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# Límite de uso por IP, por hora (0 = sin límite).
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_UPLOADS_PER_HOUR=10
# Detrás de CloudFront, la IP real del usuario llega en este encabezado (en local, dejarlo sin definir).
# CLIENT_IP_HEADER=CloudFront-Viewer-Address

# En Docker el modelo viene incluido en la imagen: si lo cambiás acá, cambialo también en el build
# (docker compose build --build-arg EMBEDDING_MODEL=...), porque el contenedor no descarga nada.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
